# Local defaults keep the HTTP server on loopback.
HOST=127.0.0.1
PORT=8787

# Limits for Streamable HTTP requests.
MCP_MAX_BODY_BYTES=2000000
MCP_REQUEST_TIMEOUT_MS=30000

# Required for bearer/both HTTP listeners, including loopback behind a tunnel.
# Generate a high-entropy secret and keep it outside version control.
MCP_AUTH_TOKEN=
# Optional separate read-only credential. It must differ from MCP_AUTH_TOKEN.
MCP_READ_TOKEN=
# Only for loopback with no tunnel or proxy; do not combine with either token.
MCP_ALLOW_ANONYMOUS_LOOPBACK=false
# Optional exact trusted browser origin. Unset means no cross-origin browser access.
CORS_ORIGIN=

# Optional storage overrides.
# ESSAY_MCP_TEMPLATE_DIR=
# ESSAY_MCP_ANSWER_DIR=
# ESSAY_MCP_EXPORT_DIR=
# ESSAY_MCP_PDF_FONT=
# ESSAY_MCP_PDF_BOLD_FONT=
# ESSAY_MCP_PDF_ITALIC_FONT=


# 165 original paper requires the unmodified MOE Std Kai 5.1 font.
# ESSAY_MCP_PAPER_FONT=/absolute/path/to/edukai-5.1_20251208.ttf

# Round B: resource server only. External AS selection/configuration is separate.
AUTH_MODE=bearer
# OAuth/both require these trusted URLs (no secrets).
# OAUTH_RESOURCE_URL=https://your-mcp.example/mcp
# OAUTH_ISSUERS=https://your-authorization-server.example
# OAUTH_JWKS_URI=https://your-authorization-server.example/jwks
# FileStore OAuth must bind its sole owner to SHA-256(JSON.stringify([issuer, sub])).
# OAUTH_FILE_OWNER_KEY=
# Opt in to fail startup/readiness without the approved 165 font.
REQUIRE_PAPER_FONT=false
# Runtime font bucket MUST differ from ESSAY_ARTIFACT_BUCKET.
# PAPER_FONT_GCS_URI=gs://dedicated-font-bucket/moe.ttf
# PAPER_FONT_GENERATION=
# PAPER_FONT_SHA256=e2b6b1bd1d6303672a68d5057a1f1e4b5361e3d8842373ff3bd1c71fb9ea9b98
