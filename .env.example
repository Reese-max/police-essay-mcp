# Local defaults keep the HTTP server on loopback.
HOST=127.0.0.1
PORT=8787

# Limits for Streamable HTTP requests.
MCP_MAX_BODY_BYTES=2000000
MCP_REQUEST_TIMEOUT_MS=30000

# Set this before exposing the server through a tunnel or non-loopback host.
MCP_AUTH_TOKEN=
MCP_ALLOW_ANONYMOUS_REMOTE=false
CORS_ORIGIN=http://localhost:3000

# Optional storage overrides.
# ESSAY_MCP_TEMPLATE_DIR=
# ESSAY_MCP_ANSWER_DIR=
# ESSAY_MCP_EXPORT_DIR=
# ESSAY_MCP_PDF_FONT=
# ESSAY_MCP_PDF_BOLD_FONT=
# ESSAY_MCP_PDF_ITALIC_FONT=

