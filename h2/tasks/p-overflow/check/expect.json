        "三、防護措施與存取控制",
        "四、事件通報與應變改善"
      ],
      "total_lines_min": 34
    }
  },
  {
    "kind": "exports_kinds",
    "label": "PDF and Word provided",
    "pdf": 1,
    "docx": 1
  },
  {
    "kind": "tool_called",
    "label": "layout checked",
    "tool": "check_layout",
    "min": 1
  },
  {
    "kind": "tool_not_called",
    "label": "no deletion",
    "tool": "delete_answer"
