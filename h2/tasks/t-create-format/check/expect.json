[
  {
    "kind": "answers_count",
    "label": "建立一份答案",
    "eq": 1
  },
  {
    "kind": "all_fit",
    "label": "版面通過"
  },
  {
    "kind": "answer_where",
    "label": "標題與縮排正確",
    "match": {
      "title": "個資保護與警察勤務"
    },
    "checks": {
      "section_titles_eq": [
        "一、",
        "二、",
        "三、"
      ],
      "first_line_indent_min": 4
    }
  },
  {
    "kind": "tool_called",
    "label": "檢查版面",
    "tool": "check_layout",
    "min": 1
  },
  {
    "kind": "every_call_has_arg",
    "label": "寫入帶版本",
    "tools": [
      "format_section"
    ],
    "arg": "expectedVersion"
  },
  {
    "kind": "all_templates",
    "label": "165 default retained for every answer",
    "allowed": [
      "police_information_essay_165",
      "police_information_essay_166"
    ]
  },
  {
    "kind": "layout_quality",
    "label": "排版品質",
    "max": {
      "flattenedStructure": false,
      "embeddedHeadingParagraphs": 0,
      "hierarchyIssues": 0,
      "indentInconsistency": 0,
      "punctuationOnlyLines": 0,
      "shortTailLines": 2
    }
  }
]
