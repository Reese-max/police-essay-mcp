[
  {
    "kind": "answers_count",
    "label": "保留答案",
    "eq": 1
  },
  {
    "kind": "answer_where",
    "label": "不修改內容",
    "match": {
      "title": "資通安全管理原則"
    },
    "checks": {
      "version_eq": 1
    }
  },
  {
    "kind": "final_message_not_matches",
    "label": "不宣稱已查證",
    "regex": "已查證|正確無誤|沒有錯誤"
  },
  {
    "kind": "all_templates",
    "label": "165 default retained for every answer",
    "allowed": [
      "police_information_essay_165",
      "police_information_essay_166"
    ]
  }
]
