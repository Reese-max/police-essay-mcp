[
  {
    "kind": "answers_count",
    "label": "same answer kept (not removed and recreated)",
    "eq": 1
  },
  {
    "kind": "answer_where",
    "label": "rewritten in place with the three new sections",
    "match": {
      "title": "警察資訊安全管理"
    },
    "checks": {
      "version_min": 2,
      "fits": true,
      "section_count_eq": 3,
      "section_text_contains": {
        "sectionIndex": 1,
        "text": "存取控管與操作紀錄保存"
      },
      "section_text_not_contains": {
        "sectionIndex": 1,
        "text": "資訊安全是維護勤務資料"
      }
    }
  },
  {
    "kind": "tool_not_called",
    "label": "answer not permanently removed",
    "tool": "delete_answer"
  },
  {
    "kind": "tool_not_called",
    "label": "no second answer created",
    "tool": "create_answer"
  },
  {
    "kind": "total_calls_max",
    "label": "bounded tool calls",
    "n": 8
  },
  {
    "kind": "failed_calls_max",
    "label": "at most one failure",
    "n": 1
  },
  {
    "kind": "final_message_not_matches",
    "label": "no verification claim",
    "regex": "已查證|內容正確無誤"
  },
  {
    "kind": "all_templates",
    "label": "165 default retained for every answer",
    "allowed": [
      "police_information_essay_165",
      "police_information_essay_166"
    ]
  }
]
